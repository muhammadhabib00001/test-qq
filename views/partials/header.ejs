<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'The Editorial Magazine' %></title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- FontAwesome for Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    /* Improve Text Layout and Legibility */
    h1, h2, h3, h4, h5, h6 {
      text-wrap: balance;
    }
    p, blockquote, li {
      text-wrap: pretty;
    }
    /* Simple Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f1f1;
    }
    ::-webkit-scrollbar-thumb {
      background: #888;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #555;
    }
  </style>

  <% if (typeof article !== 'undefined') { %>
    <!-- Primary SEO Meta Tags -->
    <meta name="title" content="<%= article.seo_title || article.title %>">
    <meta name="description" content="<%= article.seo_description || article.excerpt %>">
    <meta name="keywords" content="<%= article.tags || article.category %>">
    <link rel="canonical" href="https://test-qq-beta.vercel.app/article/<%= article.slug %>">

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="article">
    <meta property="og:url" content="https://test-qq-beta.vercel.app/article/<%= article.slug %>">
    <meta property="og:title" content="<%= article.seo_title || article.title %>">
    <meta property="og:description" content="<%= article.seo_description || article.excerpt %>">
    <meta property="og:image" content="<%= article.featured_image %>">
    <meta property="article:published_time" content="<%= new Date(article.created_at).toISOString() %>">
    <meta property="article:section" content="<%= article.category %>">

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://test-qq-beta.vercel.app/article/<%= article.slug %>">
    <meta property="twitter:title" content="<%= article.seo_title || article.title %>">
    <meta property="twitter:description" content="<%= article.seo_description || article.excerpt %>">
    <meta property="twitter:image" content="<%= article.featured_image %>">

    <!-- Comprehensive Article & BreadcrumbList Schema.org JSON-LD -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Article",
          "@id": "https://test-qq-beta.vercel.app/article/<%= article.slug %>#article",
          "isPartOf": {
            "@type": "WebSite",
            "@id": "https://test-qq-beta.vercel.app/#website",
            "name": "The Editorial Magazine",
            "url": "https://test-qq-beta.vercel.app/"
          },
          "headline": "<%= (article.seo_title || article.title).replace(/"/g, '\\"') %>",
          "description": "<%= (article.seo_description || article.excerpt).replace(/"/g, '\\"') %>",
          "image": "<%= article.featured_image %>",
          "author": {
            "@type": "Person",
            "name": "<%= article.author_name || 'Editorial Staff' %>"
          },
          "publisher": {
            "@type": "Organization",
            "name": "The Editorial Magazine",
            "logo": {
              "@type": "ImageObject",
              "url": "https://test-qq-beta.vercel.app/images/logo.png"
            }
          },
          "datePublished": "<%= new Date(article.created_at).toISOString() %>",
          "dateModified": "<%= new Date(article.updated_at || article.created_at).toISOString() %>",
          "mainEntityOfPage": "https://test-qq-beta.vercel.app/article/<%= article.slug %>",
          "articleSection": "<%= article.category %>"
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": "https://test-qq-beta.vercel.app/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "<%= article.category %>",
              "item": "https://test-qq-beta.vercel.app/category/<%= article.category %>"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": "<%= (article.title).replace(/"/g, '\\"') %>",
              "item": "https://test-qq-beta.vercel.app/article/<%= article.slug %>"
            }
          ]
        }
        <% if (typeof faq !== 'undefined' && faq && faq.length > 0) { %>,
        {
          "@type": "FAQPage",
          "mainEntity": [
            <% faq.forEach((item, idx) => { %>
              {
                "@type": "Question",
                "name": "<%= item.q.replace(/"/g, '\\"') %>",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "<%= item.a.replace(/"/g, '\\"') %>"
                }
              }<%= idx < faq.length - 1 ? ',' : '' %>
            <% }) %>
          ]
        }
        <% } %>
      ]
    }
    </script>
  <% } %>
</head>
<body class="bg-gray-50 font-sans text-gray-900 flex flex-col min-h-screen">

  <!-- Header -->
  <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        
        <!-- Logo -->
        <div class="flex-shrink-0 flex items-center">
          <a href="/" class="text-2xl font-extrabold tracking-tight text-gray-900 flex items-center gap-2">
            <span class="bg-black text-white px-2.5 py-1 rounded">E</span>
            <span>Editorial<span class="text-indigo-600">.</span></span>
          </a>
        </div>

        <!-- Navigation Desktop -->
        <nav class="hidden md:flex space-x-6 text-sm font-medium text-gray-700">
          <a href="/category/Technology" class="hover:text-indigo-600 transition">Technology</a>
          <a href="/category/Business" class="hover:text-indigo-600 transition">Business</a>
          <a href="/category/Lifestyle" class="hover:text-indigo-600 transition">Lifestyle</a>
          <a href="/category/Travel" class="hover:text-indigo-600 transition">Travel</a>
          <a href="/category/Education" class="hover:text-indigo-600 transition">Education</a>
          <a href="/page/about-us" class="hover:text-indigo-600 transition">About</a>
        </nav>

        <!-- Search Bar & Actions -->
        <div class="hidden sm:flex items-center gap-4">
          <form action="/search" method="GET" class="relative">
            <input type="text" name="q" placeholder="Search..." class="bg-gray-100 text-sm px-4 py-1.5 pr-8 rounded-full border border-transparent focus:outline-none focus:bg-white focus:border-indigo-500 transition">
            <button type="submit" class="absolute right-2.5 top-2 text-gray-400 hover:text-indigo-600">
              <i class="fa-solid fa-magnifying-glass text-sm"></i>
            </button>
          </form>
          <a href="/admin" class="text-gray-500 hover:text-indigo-600 transition text-sm">
            <i class="fa-solid fa-user-gear"></i> Admin
          </a>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <button id="mobile-menu-btn" class="md:hidden text-gray-500 hover:text-indigo-600 focus:outline-none">
          <i class="fa-solid fa-bars text-xl"></i>
        </button>

      </div>
    </div>

    <!-- Mobile Drawer -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 bg-white px-4 py-4 space-y-3">
      <a href="/category/Technology" class="block text-gray-700 font-medium hover:text-indigo-600">Technology</a>
      <a href="/category/Business" class="block text-gray-700 font-medium hover:text-indigo-600">Business</a>
      <a href="/category/Lifestyle" class="block text-gray-700 font-medium hover:text-indigo-600">Lifestyle</a>
      <a href="/category/Travel" class="block text-gray-700 font-medium hover:text-indigo-600">Travel</a>
      <a href="/category/Education" class="block text-gray-700 font-medium hover:text-indigo-600">Education</a>
      <hr class="border-gray-200">
      <form action="/search" method="GET" class="relative">
        <input type="text" name="q" placeholder="Search articles..." class="w-full bg-gray-100 text-sm px-4 py-2 pr-8 rounded-lg border focus:outline-none focus:bg-white">
        <button type="submit" class="absolute right-3 top-2.5 text-gray-400">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>
    </div>
  </header>

  <main class="flex-grow">
