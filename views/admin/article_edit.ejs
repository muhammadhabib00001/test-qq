<%- include('partials/admin_header') %>

<div class="max-w-4xl bg-white border border-gray-200 rounded-xl p-8 shadow-sm">
  <form action="/admin/article/edit/<%= article.id %>" method="POST" class="space-y-6">
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="md:col-span-2">
        <label class="block text-sm font-semibold text-gray-700 mb-2">Article Title</label>
        <input type="text" name="title" value="<%= article.title %>" required class="w-full px-4 py-2.5 border rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Category</label>
        <select name="category" class="w-full px-4 py-2.5 border rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>" <%= article.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-2">Excerpt / Summary</label>
      <textarea name="excerpt" rows="3" required class="w-full px-4 py-2.5 border rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"><%= article.excerpt %></textarea>
    </div>

    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-2">Body Content (HTML editor format)</label>
      <textarea name="body" rows="12" required class="w-full px-4 py-2.5 border rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"><%= article.body %></textarea>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Assigned Author</label>
        <select name="author_id" class="w-full px-4 py-2.5 border rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <% authors.forEach(aut => { %>
            <option value="<%= aut.id %>" <%= article.author_id === aut.id ? 'selected' : '' %>><%= aut.name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Publication Status</label>
        <select name="status" class="w-full px-4 py-2.5 border rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="draft" <%= article.status === 'draft' ? 'selected' : '' %>>Draft</option>
          <option value="published" <%= article.status === 'published' ? 'selected' : '' %>>Published (Approve)</option>
        </select>
      </div>
    </div>

    <div class="bg-gray-50 p-6 rounded-xl border space-y-4">
      <h4 class="font-bold text-gray-900 text-sm"><i class="fa-solid fa-search mr-2"></i>SEO & Image Metadata Optimization</h4>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">SEO Meta Title</label>
          <input type="text" name="seo_title" value="<%= article.seo_title %>" class="w-full px-3 py-2 border rounded-lg text-sm">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Image Alt Text</label>
          <input type="text" name="image_alt" value="<%= article.image_alt %>" class="w-full px-3 py-2 border rounded-lg text-sm">
        </div>
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1">SEO Meta Description</label>
        <input type="text" name="seo_description" value="<%= article.seo_description %>" class="w-full px-3 py-2 border rounded-lg text-sm">
      </div>
    </div>

    <div class="pt-6 border-t flex justify-end gap-3">
      <a href="/admin/review" class="px-6 py-2.5 border rounded-lg text-sm font-semibold text-gray-700 bg-white hover:bg-gray-50 transition">Cancel</a>
      <button type="submit" class="bg-indigo-600 text-white px-6 py-2.5 rounded-lg text-sm font-semibold hover:bg-indigo-700 transition">Save & Publish</button>
    </div>
  </form>
</div>

<%- include('partials/admin_footer') %>
