<%- include('partials/admin_header') %>

<div class="max-w-3xl bg-white border border-gray-200 rounded-xl p-8 shadow-sm">
  <form action="/admin/settings" method="POST" class="space-y-8">
    
    <div>
      <h3 class="font-bold text-gray-900 text-lg border-b pb-3 mb-6">Automation Controls</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Articles Generated Per Day</label>
          <input type="number" name="articles_per_day" value="<%= settings.articles_per_day %>" min="1" max="10" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Auto Publication Time Target</label>
          <input type="time" name="publishing_schedule" value="<%= settings.publishing_schedule %>" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
      </div>
    </div>

    <div>
      <h3 class="font-bold text-gray-900 text-base mb-4">Content & Metadata Pipeline Options</h3>
      <div class="space-y-4">
        
        <div class="flex items-start">
          <div class="flex items-center h-5">
            <input type="checkbox" name="auto_image_gen" value="true" <%= settings.auto_image_gen === 'true' ? 'checked' : '' %> class="h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
          </div>
          <div class="ml-3 text-sm">
            <label class="font-semibold text-gray-700">Automatic Featured Image Generation</label>
            <p class="text-gray-500">Enable default background graphic creation and optimize files to WebP format.</p>
          </div>
        </div>

        <div class="flex items-start">
          <div class="flex items-center h-5">
            <input type="checkbox" name="auto_seo_gen" value="true" <%= settings.auto_seo_gen === 'true' ? 'checked' : '' %> class="h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
          </div>
          <div class="ml-3 text-sm">
            <label class="font-semibold text-gray-700">Automatic SEO Generation</label>
            <p class="text-gray-500">Generate structured meta descriptions, search-friendly slugs, and image alt text.</p>
          </div>
        </div>

        <div class="flex items-start">
          <div class="flex items-center h-5">
            <input type="checkbox" name="internal_linking" value="true" <%= settings.internal_linking === 'true' ? 'checked' : '' %> class="h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
          </div>
          <div class="ml-3 text-sm">
            <label class="font-semibold text-gray-700">Intelligent Internal Linking</label>
            <p class="text-gray-500">Analyze topic body to add links back to related published categories.</p>
          </div>
        </div>

        <div class="flex items-start">
          <div class="flex items-center h-5">
            <input type="checkbox" name="approval_workflow" value="true" <%= settings.approval_workflow === 'true' ? 'checked' : '' %> class="h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
          </div>
          <div class="ml-3 text-sm">
            <label class="font-semibold text-gray-700">Enforce Manual Editorial Workflow</label>
            <p class="text-gray-500">Force all AI posts to require approval, human editing, and verification before publishing.</p>
          </div>
        </div>

      </div>
    </div>

    <div class="pt-6 border-t flex justify-end">
      <button type="submit" class="bg-indigo-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-indigo-700 transition">Save Settings</button>
    </div>
  </form>
</div>

<%- include('partials/admin_footer') %>
