<%- include('../partials/admin_header') %>

<div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
  <div class="p-6 border-b border-gray-200">
    <h2 class="font-bold text-gray-900 text-lg">Articles Awaiting Editorial Review</h2>
    <p class="text-sm text-gray-500 mt-1">Review, fact check, modify and approve drafts prior to publishing.</p>
  </div>
  
  <div class="divide-y divide-gray-200">
    <% if (articles && articles.length > 0) { %>
      <% articles.forEach(art => { %>
        <div class="p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 hover:bg-gray-50 transition">
          <div>
            <span class="text-xs font-semibold text-indigo-600 uppercase tracking-wider block mb-1"><%= art.category %></span>
            <h3 class="font-bold text-gray-900 text-base mb-1"><%= art.title %></h3>
            <p class="text-sm text-gray-600 max-w-2xl"><%= art.excerpt %></p>
            <div class="flex gap-3 text-xs text-gray-400 mt-3">
              <span>Author: <strong class="text-gray-600"><%= art.author_name %></strong></span>
              <span>&bull;</span>
              <span>Generated on <%= new Date(art.created_at).toLocaleDateString() %></span>
            </div>
          </div>
          <div class="flex-shrink-0 flex items-center gap-2">
            <a href="/article/<%= art.slug %>" class="px-3 py-2 border rounded-lg text-sm font-semibold text-gray-700 bg-white hover:bg-gray-50 transition" target="_blank" title="Preview Article">
              <i class="fa-solid fa-eye mr-1"></i> Preview
            </a>
            <form action="/admin/article/publish/<%= art.id %>" method="POST" class="inline">
              <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-sm font-semibold transition flex items-center gap-1 shadow-sm">
                <i class="fa-solid fa-check"></i> Publish Now
              </button>
            </form>
            <a href="/admin/article/edit/<%= art.id %>" class="px-3 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-sm font-semibold transition" title="Edit Article Details">
              <i class="fa-solid fa-edit mr-1"></i> Edit
            </a>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="p-12 text-center text-gray-500">
        <i class="fa-solid fa-square-check text-4xl text-gray-300 mb-3 block"></i>
        <p class="text-base font-semibold">Review queue is empty!</p>
        <p class="text-sm mt-1">Try triggering content generation from the dashboard header.</p>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/admin_footer') %>
