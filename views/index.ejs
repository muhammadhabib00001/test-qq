<%- include('partials/header') %>

<!-- Hero / Featured Section -->
<div class="bg-gray-900 text-white py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <% if (featured) { %>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-flex items-center px-3 py-0.5 rounded-full text-xs font-semibold bg-indigo-500 text-white tracking-wide uppercase mb-4">
            <%= featured.category %>
          </span>
          <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white mb-6">
            <a href="/article/<%= featured.slug %>" class="hover:text-indigo-400 transition">
              <%= featured.title %>
            </a>
          </h1>
          <p class="text-lg text-gray-300 mb-8"><%= featured.excerpt %></p>
          <div class="flex items-center gap-3">
            <span class="text-sm font-medium text-white"><%= featured.author_name %></span>
            <span class="text-gray-500">&bull;</span>
            <span class="text-sm text-gray-400"><%= new Date(featured.created_at).toLocaleDateString(undefined, {month: 'short', day: 'numeric', year: 'numeric'}) %></span>
          </div>
        </div>
        <div class="relative aspect-[16/9] w-full rounded-xl overflow-hidden shadow-2xl bg-gray-800">
          <img src="<%= featured.featured_image %>" alt="<%= featured.image_alt %>" class="w-full h-full object-cover">
        </div>
      </div>
    <% } else { %>
      <div class="text-center py-12">
        <h2 class="text-2xl font-bold">Welcome to The Editorial Magazine</h2>
        <p class="text-gray-400 mt-2">Articles will display here once they are approved and published by the editor.</p>
      </div>
    <% } %>
  </div>
</div>

<!-- Main Feed Layout -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
    
    <!-- Latest Articles Feed -->
    <div class="lg:col-span-2 space-y-12">
      <h2 class="text-2xl font-extrabold text-gray-900 border-b-2 border-indigo-600 pb-3 inline-block">Latest Stories</h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        <% if (latest && latest.length > 0) { %>
          <% latest.forEach(art => { %>
            <article class="bg-white rounded-xl shadow-sm border border-gray-150 overflow-hidden flex flex-col justify-between hover:shadow-md transition">
              <a href="/article/<%= art.slug %>" class="block aspect-[16/10] bg-gray-100 overflow-hidden">
                <img src="<%= art.featured_image %>" alt="<%= art.image_alt %>" class="w-full h-full object-cover hover:scale-105 transition duration-300" loading="lazy">
              </a>
              <div class="p-6 flex-grow flex flex-col justify-between">
                <div>
                  <span class="text-xs font-semibold text-indigo-600 uppercase tracking-wider block mb-2"><%= art.category %></span>
                  <h3 class="text-xl font-bold text-gray-900 mb-3 line-clamp-2">
                    <a href="/article/<%= art.slug %>" class="hover:text-indigo-600 transition"><%= art.title %></a>
                  </h3>
                  <p class="text-gray-600 text-sm mb-4 line-clamp-3"><%= art.excerpt %></p>
                </div>
                <div class="flex items-center justify-between text-xs text-gray-500 pt-4 border-t border-gray-100">
                  <span>By <%= art.author_name %></span>
                  <span><%= new Date(art.created_at).toLocaleDateString() %></span>
                </div>
              </div>
            </article>
          <% }) %>
        <% } else { %>
          <p class="text-gray-500 col-span-2">No other posts published yet.</p>
        <% } %>
      </div>
    </div>

    <!-- Sidebar (Popular + Newsletter) -->
    <div class="space-y-12">
      
      <!-- Newsletter Signup -->
      <div class="bg-indigo-50 rounded-2xl p-8 border border-indigo-100">
        <h3 class="text-xl font-extrabold text-indigo-900 mb-2">Subscribe to Editorial</h3>
        <p class="text-sm text-indigo-700 mb-6">Get weekly insights, curated research, and premium summaries sent straight to your inbox.</p>
        <form class="space-y-3" onsubmit="event.preventDefault(); alert('Subscribed successfully!');">
          <input type="email" placeholder="Your email address" required class="w-full px-4 py-3 rounded-lg border border-indigo-200 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <button type="submit" class="w-full bg-indigo-600 text-white font-semibold py-3 rounded-lg text-sm hover:bg-indigo-700 transition">Join Newsletter</button>
        </form>
      </div>

      <!-- Popular / Trending Articles -->
      <div>
        <h3 class="text-lg font-bold text-gray-900 border-b border-gray-200 pb-3 mb-6">Popular Insights</h3>
        <div class="space-y-6">
          <% if (popular && popular.length > 0) { %>
            <% popular.forEach((art, index) => { %>
              <div class="flex gap-4">
                <span class="text-3xl font-black text-gray-200 w-8 text-center flex-shrink-0">0<%= index + 1 %></span>
                <div>
                  <h4 class="font-bold text-gray-900 leading-snug">
                    <a href="/article/<%= art.slug %>" class="hover:text-indigo-600 transition"><%= art.title %></a>
                  </h4>
                  <span class="text-xs text-gray-500 uppercase tracking-wider block mt-1"><%= art.category %></span>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <p class="text-sm text-gray-500">No popular posts to show yet.</p>
          <% } %>
        </div>
      </div>

    </div>

  </div>
</div>

<%- include('partials/footer') %>
