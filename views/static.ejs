<%- include('partials/header') %>

<div class="bg-gray-50 py-12">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumbs -->
    <nav class="flex text-xs text-gray-500 mb-6" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a href="/" class="hover:text-indigo-600">Home</a>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
            <i class="fa-solid fa-chevron-right text-[10px] mx-2 text-gray-400"></i>
            <span class="text-gray-400 font-medium"><%= title %></span>
          </div>
        </li>
      </ol>
    </nav>

    <!-- Page Content Card -->
    <article class="bg-white rounded-2xl shadow-sm border border-gray-150 p-8 sm:p-12">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 mb-8 border-b pb-4"><%= title %></h1>
      <div class="prose max-w-none text-gray-700 leading-relaxed space-y-6">
        <%- content %>
      </div>
    </article>

  </div>
</div>

<%- include('partials/footer') %>
