<%- include('partials/header') %>

<div class="bg-gray-50 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Author Bio Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-150 p-8 sm:p-12 mb-12 flex flex-col md:flex-row items-center gap-8">
      <div class="w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-indigo-150 overflow-hidden flex-shrink-0">
        <img src="<%= author.avatar %>" alt="<%= author.name %>" class="w-full h-full object-cover">
      </div>
      <div>
        <span class="text-xs font-semibold text-indigo-600 uppercase tracking-wider block mb-1"><%= author.role %></span>
        <h1 class="text-3xl font-extrabold text-gray-900 mb-4"><%= author.name %></h1>
        <p class="text-gray-700 leading-relaxed max-w-2xl"><%= author.bio %></p>
      </div>
    </div>

    <!-- Author Articles List -->
    <h2 class="text-2xl font-extrabold text-gray-900 mb-8 border-b-2 border-indigo-600 pb-3 inline-block">Articles by <%= author.name %></h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% if (articles && articles.length > 0) { %>
        <% articles.forEach(art => { %>
          <article class="bg-white rounded-xl shadow-sm border border-gray-150 overflow-hidden flex flex-col justify-between hover:shadow-md transition">
            <a href="/article/<%= art.slug %>" class="block aspect-[16/10] bg-gray-100 overflow-hidden">
              <img src="<%= art.featured_image %>" alt="<%= art.image_alt %>" class="w-full h-full object-cover hover:scale-105 transition duration-300" loading="lazy">
            </a>
            <div class="p-6 flex-grow flex flex-col justify-between">
              <div>
                <span class="text-xs font-semibold text-indigo-600 uppercase tracking-wider block mb-2"><%= art.category %></span>
                <h3 class="text-xl font-bold text-gray-900 mb-3 line-clamp-2">
                  <a href="/article/<%= art.slug %>" class="hover:text-indigo-600 transition"><%= art.title %></a>
                </h3>
                <p class="text-gray-600 text-sm mb-4 line-clamp-3"><%= art.excerpt %></p>
              </div>
              <div class="flex items-center justify-between text-xs text-gray-500 pt-4 border-t border-gray-100">
                <span><%= new Date(art.created_at).toLocaleDateString() %></span>
                <span><i class="fa-solid fa-eye"></i> <%= art.views %> views</span>
              </div>
            </div>
          </article>
        <% }) %>
      <% } else { %>
        <p class="text-gray-500">No articles published by this author yet.</p>
      <% } %>
    </div>

  </div>
</div>

<%- include('partials/footer') %>
